# P05 - LLMOps with Ollama (local open models)
# Copy to .env and edit

OLLAMA_MODEL=llama3.2
# or qwen2.5:7b, gemma2, mistral, etc.
# Make sure you have pulled it: ollama pull llama3.2

# Simulated pricing for teaching (USD per 1M tokens)
# Set to 0.0 if you want pure free local run
INPUT_PRICE_PER_MILLION=0.10
OUTPUT_PRICE_PER_MILLION=0.30
CACHED_INPUT_PRICE_PER_MILLION=0.01

# Demo budgets
TEAM_BUDGET_USD=0.50
MAX_DEPTH=8
